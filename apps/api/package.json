{
  "name": "@fieldissue/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "node --import tsx src/migrate.ts",
    "seed": "node --import tsx src/migrate.ts seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@fieldissue/shared": "*",
    "@hono/node-server": "2.1.3",
    "@mastra/core": "1.74.0",
    "@sentry/node": "11.4.0",
    "dotenv": "18.0.5",
    "hono": "4.13.13",
    "leaflet": "1.9.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
