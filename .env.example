# Local development only. Copy to .env; never commit real credentials.
NODE_ENV=development
ENVIRONMENT=development
PORT=3000
POSTGRES_USER=fieldissue
POSTGRES_PASSWORD=fieldissue-development-only
POSTGRES_DB=fieldissue
# Host URL; Compose replaces this with its private db hostname.
DATABASE_URL=postgresql://fieldissue:fieldissue-development-only@127.0.0.1:5432/fieldissue
DATABASE_SSL=false
# DATABASE_CA_FILE=/absolute/path/to/provider-ca.pem
INTELLIGENCE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_TOKEN=development-only-change-me
# Production always requires a distinct 32+ character shared gateway token.
# API_ACCESS_TOKEN=
AI_MOCK_MODE=true
PROVIDER_TIMEOUT_MS=120000
AI_TIMEOUT_SECONDS=30
AI_TOTAL_TIMEOUT_SECONDS=95
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.25
MAX_UPLOAD_BYTES=10485760
STORAGE_PROVIDER=local
# Production: postgres (bounded DB media) or s3. Local is development-only.
MEDIA_DATABASE_MAX_BYTES=209715200
PROVIDER_DAILY_UNITS=60
WRITE_REQUESTS_PER_MINUTE=30
PROVIDER_CONCURRENCY=2
# DATA_RETENTION_NOTICE=State the deployed database retention limit here.
LOCAL_STORAGE_PATH=.media
MEDIA_BASE_URL=http://127.0.0.1:3000/media

# Real vision inference: set all model identity fields, then AI_MOCK_MODE=false.
# Requires a separately provisioned, vision-capable Gemma runtime.
GEMMA_BASE_URL=
GEMMA_MODEL=
GEMMA_MODEL_VERSION=
GEMMA_API_KEY=

# Genuine labeled history and trusted official local TabPFN weights are required
# in real mode. Container paths must be mounted separately; see service README.
TABPFN_TRAINING_DATA=
TABPFN_WEIGHTS_PATH=
TABPFN_MODEL_VERSION=
TABPFN_DEVICE=cpu
# Explicit opt-in optional runtime dependency for the intelligence Docker build.
INSTALL_TABPFN=false

# Optional provider integrations. Leave unused settings commented, especially URLs.
# SERPAPI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# SENTRY_DSN=https://public-key@your-sentry-host/your-project-id

# S3-compatible storage: STORAGE_PROVIDER=s3 requires bucket and both credentials.
# Set MEDIA_BASE_URL to your actual API /media route or authorized public CDN.
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# S3_REGION=us-east-1
# S3_BUCKET=fieldissue-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Opt-in paid training only; never set a real key in a committed file.
# TINKER_API_KEY=

# Optional V2 integrations; Tiger is secondary, never the hosted primary.
# BACKBOARD_API_KEY=
# TIGER_DATABASE_URL=postgresql://user:password@trusted-tiger-host:5432/tsdb
SEMANTIC_SEARCH_ENABLED=false

# 0 disables automatic expiry; positive values remove inactive issues after this many days.
DATA_RETENTION_DAYS=0
